{
  "name": "intellisense-toggle",
  "displayName": "IntelliSense Toggle",
  "description": "Quickly toggle VS Code IntelliSense (quick suggestions) on and off — handy when you want Copilot's suggestions without IntelliSense popping up first.",
  "version": "1.3.0",
  "publisher": "studiomedio",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/studiomedio/intellisense-toggle"
  },
  "bugs": {
    "url": "https://github.com/studiomedio/intellisense-toggle/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "intellisense",
    "autocomplete",
    "suggestions",
    "toggle",
    "productivity",
    "quick suggestions",
    "copilot"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#D9D9DD",
    "theme": "light"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "toggleIntelliSense",
        "title": "Toggle IntelliSense",
        "category": "IntelliSense Toggle"
      }
    ],
    "keybindings": [
      {
        "command": "toggleIntelliSense",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.js --test && node --test \"out-test/*.test.js\"",
    "package": "vsce package",
    "test:integration": "node esbuild.js && node esbuild.js --integration && node test/integration/run.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
